generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(6)

  // Relations
  createdTrips      Trip[]           @relation("CreatedTrips")
  memberships       TripMember[]
  invitationsSent   TripInvitation[] @relation("InvitationsSent")
  expensesPaid      Expense[]        @relation("ExpensesPaid")
  expensesCreated   Expense[]        @relation("ExpensesCreated")
  expenseSplits     ExpenseSplit[]

  @@map("users")
}

model Trip {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(100)
  description  String?  @db.Text
  baseCurrency String   @default("SAR") @db.VarChar(10)
  city         String?  @db.VarChar(100)
  creatorId    Int
  creator      User     @relation("CreatedTrips", fields: [creatorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members     TripMember[]
  invitations TripInvitation[]
  expenses    Expense[]

  @@map("trips")
}

model Expense {
  id          Int      @id @default(autoincrement())
  tripId      Int
  title       String   @db.VarChar(100)
  amount      Decimal  @db.Decimal(10, 2)
  paidById    Int
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy    User           @relation("ExpensesPaid", fields: [paidById], references: [id])
  createdBy User           @relation("ExpensesCreated", fields: [createdById], references: [id])
  splits    ExpenseSplit[]

  @@map("expenses")
}

model ExpenseSplit {
  expenseId Int
  userId    Int
  amount    Decimal @db.Decimal(10, 2)
  isPaid    Boolean @default(false)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseId, userId])
  @@map("expense_splits")
}

model TripMember {
  tripId   Int
  userId   Int
  role     String   @default("MEMBER") // ADMIN, MEMBER
  joinedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
  @@map("trip_members")
}

model TripInvitation {
  id           Int      @id @default(autoincrement())
  tripId       Int
  inviterId    Int
  inviteeEmail String   @db.VarChar(150)
  status       String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt    DateTime @default(now())

  trip    Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  inviter User @relation("InvitationsSent", fields: [inviterId], references: [id])

  @@map("trip_invitations")
}
